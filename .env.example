# ============================================================
#  Voice Command Shopping Assistant — Root .env Reference
#  Copy relevant sections into Backend/.env and Frontend/.env
#  NEVER commit actual .env files to version control
# ============================================================

# ─── BACKEND (copy to Backend/.env) ─────────────────────────

# MongoDB Atlas connection string
# Get from: Atlas Dashboard → Connect → Connect your application
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Port for Express server
PORT=5000

# Node environment
NODE_ENV=development

# CORS allowed origins (comma-separated for multiple, or * for all origins)
ALLOWED_ORIGINS=*

# ─── FRONTEND (copy to Frontend/.env) ────────────────────────
# All Vite env vars MUST be prefixed with VITE_

# Backend API base URL
# In production: your Render backend URL
VITE_API_URL=http://localhost:5000

# Default speech recognition language code
# Options: en-IN (English India), hi-IN (Hindi), en-US, etc.
VITE_DEFAULT_LANG=en-IN

# ─── FUTURE / OPTIONAL (if upgrading to LLM-based parsing) ───

# Groq API key (free tier available)
# GROQ_API_KEY=

# Google Gemini API key (free tier available)
# GEMINI_API_KEY=
